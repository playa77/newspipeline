# newspipeline secrets — copy to .env and fill in. Never commit .env.

# LLM provider API key (OpenAI-compatible endpoint).
# Default provider is OpenRouter: https://openrouter.ai/keys
NEWS_API_KEY=sk-or-v1-...

# Optional: override the provider endpoint.
# Default: https://openrouter.ai/api/v1
# NEWS_API_BASE_URL=https://openrouter.ai/api/v1

# SMTP password (only needed when an interest uses the "email" delivery mode
# and the SMTP server requires authentication). Not needed for a local
# unauthenticated relay.
#
# Gmail relay: this is an APP PASSWORD, not the account password. Enable
# 2FA on the dedicated sender account first, then create the app password
# under Google Account -> Security -> 2-Step Verification -> App passwords.
# See README.md ("Gmail relay").
# NEWS_SMTP_PASSWORD=
